{
  "expo": {
    "name": "Lunivo",
    "slug": "lunivo",
    "scheme": "lunivo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.orangi.lunivo",
      "supportsTablet": true
    },
    "android": {
      "package": "com.orangi.lunivo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071625"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071625",
          "image": "./assets/lunivo-logo-splash.png",
          "imageWidth": 205,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/lunivo-logo-splash.png",
            "backgroundColor": "#071625"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "productStage": "foundation",
      "router": {},
      "eas": {
        "projectId": "1de059f0-f569-43fd-9579-9d058bf0e4e4"
      }
    },
    "owner": "lunivos-team"
  }
}
