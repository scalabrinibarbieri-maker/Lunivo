{
  "expo": {
    "name": "Lunivo",
    "slug": "lunivo",
    "scheme": "lunivo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.orangi.lunivo",
      "supportsTablet": true
    },
    "android": {
      "package": "com.orangi.lunivo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14273F"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "productStage": "foundation"
    }
  }
}
